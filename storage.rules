rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Files are linked directly from the page (<img>, <a>), so reads are public; ids are random 128-bit values.
    match /assets/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.metadata.owner == request.auth.uid
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|video/.*|text/.*');
      // The uploader or a facilitator (same /facilitators list as firestore.rules).
      allow delete: if request.auth != null && (resource.metadata.owner == request.auth.uid
        || firestore.exists(/databases/(default)/documents/facilitators/$(request.auth.token.email.lower())));
    }
  }
}
